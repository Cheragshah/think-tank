# Optional. The room works without this file. When the `opencode` CLI is on
# PATH, the room starts in chat mode and can run councils through OpenCode.
#
# COUNCIL_RUNNER:
#   opencode  chat with the Chair in the room, using your local OpenCode setup
#   viewer    only watch councils started in Claude Code or OpenCode
#   api       run councils on your Anthropic API account (needs the key below)
# Leave it blank to auto-detect (opencode when installed, otherwise viewer).
COUNCIL_RUNNER=

# Only for COUNCIL_RUNNER=api. About 25 calls per full council.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Set a shared password before exposing the room online. The browser will ask
# for APP_USER and APP_PASSWORD. Leave blank locally.
APP_PASSWORD=
APP_USER=think-tank

# Background leader builds use this model. The chat model comes from
# `opencode models`, so add the provider key you use (for example DeepSeek).
LEADER_MODEL=deepseek/deepseek-v4-pro
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=

# Optional: path to the opencode binary when it is not on PATH.
# OPENCODE_BIN=/Users/you/.opencode/bin/opencode

# Used by /new-thinker to make a new advisor's cartoon portrait (about 5 image jobs each).
# Get a key at https://kie.ai/api-key
KIE_AI_API_KEY=
